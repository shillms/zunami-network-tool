{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Docker Network Profiler and PlantUML Schema",
  "type": "object",
  "required": ["observation_window_sec", "nodes", "edges", "alerts"],
  "properties": {
    "observation_window_sec": {
      "type": "integer",
      "minimum": 1
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "host",
          "state",
          "status",
          "traffic_level",
          "bytes_in",
          "bytes_out",
          "last_seen_at",
          "manual_override"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "host": { "type": "string", "minLength": 1 },
          "state": {
            "type": "string",
            "enum": ["running", "paused", "exited", "created", "dead", "external"]
          },
          "status": {
            "type": "string",
            "enum": ["active", "idle", "frozen", "stale"]
          },
          "traffic_level": {
            "type": "string",
            "enum": ["high", "medium", "low", "none"]
          },
          "bytes_in": { "type": "integer", "minimum": 0 },
          "bytes_out": { "type": "integer", "minimum": 0 },
          "last_seen_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "manual_override": {
            "type": ["object", "null"],
            "properties": {
              "enabled": { "type": "boolean" },
              "status": {
                "type": ["string", "null"],
                "enum": ["active", "idle", "frozen", "stale", null]
              },
              "role_or_type": { "type": ["string", "null"] },
              "note": { "type": ["string", "null"] },
              "updated_by": { "type": ["string", "null"] },
              "updated_at": {
                "type": ["string", "null"],
                "format": "date-time"
              }
            },
            "required": [
              "enabled",
              "status",
              "role_or_type",
              "note",
              "updated_by",
              "updated_at"
            ]
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "target",
          "protocol",
          "bytes_transferred",
          "packet_count",
          "is_external"
        ],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1 },
          "protocol": {
            "type": "string",
            "enum": ["tcp", "udp", "icmp", "unknown"]
          },
          "bytes_transferred": { "type": "integer", "minimum": 0 },
          "packet_count": { "type": "integer", "minimum": 0 },
          "is_external": { "type": "boolean" }
        }
      }
    },
    "alerts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "code", "message", "node_id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "severity": {
            "type": "string",
            "enum": ["info", "warning", "critical"]
          },
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 },
          "node_id": { "type": ["string", "null"] }
        }
      }
    }
  }
}
